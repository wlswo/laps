---
// The landing page, in either language: icon, name, one line and the store button, then one bento of real app
// screens, the price and the questions. The only motion is the tiles coming in, once.
import '../styles/landing.css';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shot = (name: string) => `${base}/shots/${lang}/${name}.png`;
const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
// "Laps" picked out in orange.
const brand = (text: string) => text.split(/(Laps)/).map((part) => ({ part, laps: part === 'Laps' }));
---

<section class="hero">
  <img class="hero-icon" src={`${base}/icon.png`} alt="" width="128" height="128" />
  <h1>Laps</h1>
  <p class="tagline">{brand(s.hero.tagline).map(({ part, laps }) => (laps ? <b>{part}</b> : part))}</p>
  <span class="store">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1-2.8-4.1zM14 5.2c.7-.8 1.2-2 1-3.2-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.3z" /></svg>
    <span><small>{s.hero.storeSmall}</small><strong>{s.hero.storeBig}</strong></span>
  </span>
  <p class="free">{s.hero.free}</p>
</section>

<section class="wrap">
  <div class="bento">
    <div class="tile tall" data-in>
      <div class="clip"><div class="phone"><img src={shot('home')} alt="" loading="lazy" /></div></div>
      <div class="copy"><h3>{s.tiles.home.title}</h3><p>{s.tiles.home.text}</p></div>
    </div>
    <div class="tile wide" data-in>
      <div class="clip"><div class="phone"><img src={shot('pace')} alt="" loading="lazy" /></div></div>
      <div class="copy"><span class="kicker">{s.tiles.pace.kicker}</span><h3>{s.tiles.pace.title}</h3><p>{s.tiles.pace.text}</p></div>
    </div>
    <div class="tile t-brand" data-in>
      <img src={`${base}/icon.png`} alt="" width="76" height="76" loading="lazy" />
      <span class="name">Laps</span>
      <p>{s.tiles.brand}</p>
    </div>
    <div class="tile t-widget" data-in>
      <div class="clip"><img class="widget" src={shot('widget')} alt="" loading="lazy" /></div>
      <div class="copy"><span class="kicker">{s.tiles.widget.kicker}</span><h3>{s.tiles.widget.title}</h3><p>{s.tiles.widget.text}</p></div>
    </div>
    <div class="tile wide" data-in>
      <div class="clip"><div class="phone"><img src={shot('preview')} alt="" loading="lazy" /></div></div>
      <div class="copy"><span class="kicker">{s.tiles.calc.kicker}</span><h3>{s.tiles.calc.title}</h3><p>{s.tiles.calc.text}</p></div>
    </div>
    <div class="tile t-history" data-in>
      <div class="clip"><div class="phone"><img src={shot('history')} alt="" loading="lazy" /></div></div>
      <div class="copy"><h3>{s.tiles.history.title}</h3><p>{s.tiles.history.text}</p></div>
    </div>
  </div>
</section>

<section class="section" id="price">
  <h2>{s.pricing.title}</h2>
  <div class="plans">
    {[s.pricing.free, s.pricing.pass].map((plan, i) => (
      <div class:list={['plan', { pass: i === 1 }]} data-in>
        {i === 1 && <span class="beam-glow" aria-hidden="true" />}
        <span class="plan-name">{plan.name}</span>
        <span class="plan-price">{plan.price}{plan.unit && <small> {plan.unit}</small>}</span>
        <p>{plan.text}</p>
        {i === 1 && <span class="beam" aria-hidden="true" />}
      </div>
    ))}
  </div>
</section>

<section class="section" id="faq">
  <h2>{s.faq.title[0]}</h2>
  <div class="faq">
    {s.faq.items.map(([q, a]) => (
      <details class="qa">
        <summary><span>{q}</span><i aria-hidden="true" /></summary>
        <div class="answer"><p>{a}</p></div>
      </details>
    ))}
  </div>
  <p class="faq-more" set:html={fill(s.faq.more, { mail: '<a href="mailto:laps@wlswo.me">laps@wlswo.me</a>' })} />
</section>

<script>
  import '../scripts/landing.js';
</script>
