---
// The landing page, in either language. "Leave the math to Laps": a live copy of the app's home screen, the app's
// own scheduling math to play with, pace when you fall behind, a tour of the screens, the motion details, price
// and FAQ. All interaction lives in src/scripts/landing.js; this file is the markup.
import '../styles/landing.css';
import { t, type Lang, languages } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
const read = s.home.books.filter((b) => b.done).reduce((sum, b) => sum + b.pages, 0);
const totalToday = s.home.books.reduce((sum, b) => sum + b.pages, 0);
const left = totalToday - read;
---

<script type="application/json" id="laps-data" set:html={JSON.stringify({ lang, s })} />

<!-- Hero: the promise, and the app's home screen to tap. -->
<section class="hero wrap" id="top">
  <div class="hero-copy" data-reveal>
    <p class="kicker">{s.hero.kicker}</p>
    <h1>
      <span class="line">{s.hero.headline[0]}</span>
      <span class="line"><span class="mark">{s.hero.headline[1]}</span></span>
    </h1>
    <p class="lead">{s.hero.lead}</p>
    <p class="chip">{s.hero.free}</p>
    <div class="cta-row">
      <span class="soon">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1-2.8-4.1zM14 5.2c.7-.8 1.2-2 1-3.2-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.3z"/></svg>
        {s.hero.soon}
      </span>
      <a class="link" href="#calc">{s.hero.try} ↓</a>
    </div>
  </div>

  <div class="hero-app" data-reveal>
    <div class="app" data-home>
      <div class="app-top">
        <span class="app-date">{s.home.date}</span>
        <span class="app-exam">{s.home.exam}</span>
      </div>
      <div class="app-big">
        <div class="app-count" data-count>
          <span class="roll big" data-roll data-value={left}>{left}</span>
          <span class="app-unit">{s.home.unit}</span>
        </div>
        <div class="app-done" data-done aria-hidden="true">
          <strong>{s.home.done}</strong>
          <span data-all-read>{fill(s.home.allRead, { n: totalToday })}</span>
        </div>
        <span class="app-add">{s.home.add}</span>
      </div>
      <div class="app-head">
        <span class="kicker">{s.home.todo}</span>
        <span class="app-readof" data-readof>{fill(s.home.readOf, { read, total: totalToday })}</span>
      </div>
      <div class="box app-list">
        {s.home.books.map((book, i) => (
          <button class:list={['app-row', { done: book.done }]} data-row={i} aria-pressed={book.done ? 'true' : 'false'}>
            <span class="check" aria-hidden="true"><i /></span>
            <span class="app-title">
              <b>{book.title}</b>
              <small>{book.read}</small>
            </span>
            <span class="app-range">
              <b>{book.range}</b>
              <small>{fill(s.home.pagesN, { n: book.pages })}</small>
            </span>
          </button>
        ))}
      </div>
      <div class="app-head">
        <span class="kicker">{s.home.progress}</span>
        <span class="app-readof">{s.home.progressHint}</span>
      </div>
      <div class="box app-progress">
        {s.home.books.map((book, i) => (
          <div class="prog">
            <span class="prog-title">{book.title}</span>
            <span class="blocks" style={`--reads:${book.reads}`}>
              <i data-prog={i} style={`width:${(book.position / (book.pagesPerPass * book.reads)) * 100}%`} />
              {Array.from({ length: book.reads - 1 }, (_, k) => <span class="sep" data-at={(k + 1) / book.reads} style={`left:${((k + 1) / book.reads) * 100}%`} />)}
            </span>
          </div>
        ))}
      </div>
    </div>
    <p class="hint"><span aria-hidden="true">↖</span> {s.hero.hint}</p>
  </div>
</section>

<!-- 01 The math: the app's calculation, live. -->
<section class="band dark" id="calc">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{s.calc.kicker}</p>
      <h2>{s.calc.title[0]}<br />{s.calc.title[1]}</h2>
      <p class="section-lead">{s.calc.lead}</p>
    </header>

    <div class="calc" data-calc data-reveal>
      <div class="controls">
        <div class="control">
          <label for="calc-pages">{s.calc.pages}</label>
          <div class="stepper">
            <button type="button" data-step="pages" data-by="-10" aria-label="−">−</button>
            <output class="num" data-out="pages">600</output>
            <button type="button" data-step="pages" data-by="10" aria-label="+">+</button>
          </div>
          <input id="calc-pages" type="range" min="50" max="1500" step="10" value="600" data-input="pages" />
        </div>
        <div class="control">
          <label>{s.calc.reads}</label>
          <div class="stepper">
            <button type="button" data-step="reads" data-by="-1" aria-label="−">−</button>
            <output class="num" data-out="reads">5</output>
            <button type="button" data-step="reads" data-by="1" aria-label="+">+</button>
          </div>
          <div class="read-dots" data-read-dots>{Array.from({ length: 10 }, () => <i />)}</div>
        </div>
        <div class="control">
          <label for="calc-days">{s.calc.days}</label>
          <div class="days-line">
            <output class="num" data-out="days">90</output>
            <span data-out="finish"></span>
          </div>
          <input id="calc-days" type="range" min="7" max="365" step="1" value="90" data-input="days" />
        </div>
        <div class="control">
          <label>{s.calc.rest}</label>
          <div class="weekdays">
            {s.calc.weekdays.map((d, i) => (
              <button type="button" class:list={[{ sun: i === 6 }]} data-rest={(i + 1) % 7} aria-pressed="false">{d}</button>
            ))}
          </div>
        </div>
        <div class="control">
          <label>{s.calc.speed}</label>
          <div class="stepper">
            <button type="button" data-step="speed" data-by="-0.1" aria-label="−">−</button>
            <output class="num" data-out="speed">1.7</output>
            <button type="button" data-step="speed" data-by="0.1" aria-label="+">+</button>
          </div>
          <p class="control-note" data-out="speedNote"></p>
        </div>
      </div>

      <div class="results">
        <div class="headline-stats">
          <div class="first">
            <span class="label">{s.calc.firstDay}</span>
            <span class="value"><span class="roll huge" data-roll="first" data-value="17">17</span><em>{s.calc.perDayUnit}</em></span>
          </div>
          <div class="side">
            <div><span class="label">{s.calc.peak}</span><span class="num side-value" data-out="peak">64</span></div>
            <div><span class="label">{s.calc.finish}</span><span class="side-value" data-out="finishDate"></span></div>
          </div>
        </div>
        <p class="heavy" data-heavy hidden><span class="warn">{s.calc.heavy}</span><span data-heavy-note></span></p>
        <div class="reads" data-reads></div>
        <div class="timeline">
          <div class="timeline-head"><span class="label">{s.calc.timeline}</span><span class="label" data-timeline-end></span></div>
          <div class="track" data-track></div>
          <div class="ticks" data-ticks></div>
        </div>
        <p class="footnote" data-footnote></p>
      </div>
    </div>
  </div>
</section>

<!-- 02 Pace: fall behind and see it spread out again. -->
<section class="band" id="pace">
  <div class="wrap pace">
    <header class="section-head" data-reveal>
      <p class="kicker">{s.pace.kicker}</p>
      <h2>{s.pace.title[0]}<br />{s.pace.title[1]}</h2>
      <p class="section-lead">{s.pace.lead}</p>
    </header>
    <div class="pace-card box" data-pace data-reveal>
      <div class="pace-top">
        <div class="pace-readout">
          <span class="label">{s.pace.at}</span>
          <strong data-pace-shift></strong>
        </div>
        <div class="pace-number">
          {s.pace.pre && <span class="pace-unit">{s.pace.pre}</span>}
          <span class="num" data-pace-number>+2</span>
          <span class="pace-unit">{s.pace.unit}</span>
        </div>
      </div>
      <input type="range" min="-7" max="14" step="1" value="7" data-pace-input aria-label={s.pace.at} />
      <div class="pace-scale"><span>{s.pace.ahead.replace('{n}', '7')}</span><span>{s.pace.onPlan}</span><span>{s.pace.behind.replace('{n}', '14')}</span></div>
      <p class="pace-note" data-pace-note></p>
      <div class="pace-past">
        <div class="pace-row-head">
          <span class="label">{s.pace.past}</span>
          <span class="pace-legend"><span><i class="lg read" />{s.pace.read}</span><span><i class="lg missed" />{s.pace.missed}</span></span>
        </div>
        <div class="pace-days" data-pace-days></div>
      </div>
      <div class="pace-bars">
        <div class="pb">
          <span class="label">{s.pace.plan}</span>
          <span class="pb-track"><i class="pb-plan" data-pb="plan" /></span>
          <span class="pb-n num" data-pb-n="plan"></span>
        </div>
        <div class="pb">
          <span class="label">{s.pace.replanned}</span>
          <span class="pb-track"><i class="pb-replan" data-pb="replan" /></span>
          <span class="pb-n num" data-pb-n="replan"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 03 Tour: the screens, one at a time. -->
<section class="band" id="tour">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{s.tour.kicker}</p>
      <h2>{s.tour.title[0]}<br />{s.tour.title[1]}</h2>
    </header>
    <div class="tour" data-tour data-reveal>
      <div class="tabs" role="tablist">
        {s.tour.tabs.map((tab, i) => (
          <button type="button" role="tab" class="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
            <span class="tab-num num">{String(i + 1).padStart(2, '0')}</span>
            <span class="tab-text">
              <span class="tab-label">{tab.label}</span>
              <b>{tab.title}</b>
              <span class="tab-desc">{tab.text}</span>
            </span>
          </button>
        ))}
      </div>
      <div class="device">
        <div class="screen">
          {s.tour.tabs.map((tab, i) =>
            tab.id === 'widgets' ? (
              <div class:list={['shot', 'wall', { on: i === 0 }]} data-shot={i}>
                <div class="wall-row">
                  <img src={`${base}/app/${lang}/widget-small.png`} alt="" class="w-small" loading="lazy" />
                  <img src={`${base}/app/${lang}/widget-lock.png`} alt="" class="w-lock" loading="lazy" />
                </div>
                <img src={`${base}/app/${lang}/widget-medium.png`} alt="" class="w-medium" loading="lazy" />
              </div>
            ) : (
              <img class:list={['shot', { on: i === 0 }]} data-shot={i} src={`${base}/app/${lang}/${tab.id}.png`} alt={tab.title} loading={i === 0 ? 'eager' : 'lazy'} />
            )
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 04 Details: the motion, shown small. -->
<section class="band" id="details">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{s.details.kicker}</p>
      <h2>{s.details.title[0]}<br />{s.details.title[1]}</h2>
      <p class="section-lead">{s.details.lead}</p>
    </header>
    <div class="details" data-details>
      <article class="box detail" data-reveal>
        <div class="demo demo-number" data-demo="number">
          <span class="roll mid" data-roll="demo" data-value="58">58</span>
          <span class="demo-unit">{s.details.demoUnit}</span>
        </div>
        <h3>{s.details.items[0].title}</h3>
        <p>{s.details.items[0].text}</p>
        <button type="button" class="replay link" data-replay="number">{s.details.replay}</button>
      </article>
      <article class="box detail" data-reveal>
        <div class="demo demo-check" data-demo="check">
          <span class="app-row demo-row"><span class="check" aria-hidden="true"><i /></span><span class="app-title"><b>{s.details.demoBook}</b></span><span class="app-range"><b>{s.details.demoRange}</b></span></span>
        </div>
        <h3>{s.details.items[1].title}</h3>
        <p>{s.details.items[1].text}</p>
        <button type="button" class="replay link" data-replay="check">{s.details.replay}</button>
      </article>
      <article class="box detail" data-reveal>
        <div class="demo demo-blocks" data-demo="blocks">
          <span class="blocks tall" style="--reads:5"><i data-demo-fill style="width:0%" />{[1, 2, 3, 4].map((k) => <span class="sep" data-at={k / 5} style={`left:${k * 20}%`} />)}</span>
        </div>
        <h3>{s.details.items[2].title}</h3>
        <p>{s.details.items[2].text}</p>
        <button type="button" class="replay link" data-replay="blocks">{s.details.replay}</button>
      </article>
    </div>
  </div>
</section>

<!-- 05 Price -->
<section class="band" id="price">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{s.pricing.kicker}</p>
      <h2>{s.pricing.title[0]}<br />{s.pricing.title[1]}</h2>
    </header>
    <div class="plans">
      <div class="box plan" data-reveal>
        <div class="plan-head"><h3>{s.pricing.free.title}</h3><span>{s.pricing.free.price}</span></div>
        <ul>{s.pricing.free.lines.map((line) => <li>{line}</li>)}</ul>
      </div>
      <div class="box plan pass" data-reveal>
        <div class="plan-head"><h3>{s.pricing.pass.title}</h3><span>{s.pricing.pass.price}</span></div>
        <ul>{s.pricing.pass.lines.map((line) => <li>{line}</li>)}</ul>
      </div>
    </div>
    <p class="langs" data-reveal>{s.languagesLabel}: {languages}</p>
  </div>
</section>

<!-- 06 FAQ -->
<section class="band" id="faq">
  <div class="wrap faq-wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{s.faq.kicker}</p>
      <h2>{s.faq.title[0]}</h2>
    </header>
    <div class="box faq" data-reveal>
      {s.faq.items.map(([q, a]) => (
        <details class="qa">
          <summary><span>{q}</span><i aria-hidden="true" /></summary>
          <div class="answer"><p>{a}</p></div>
        </details>
      ))}
    </div>
    <p class="faq-more" data-reveal set:html={fill(s.faq.more, { mail: '<a class="link" href="mailto:laps@wlswo.me">laps@wlswo.me</a>' })} />
  </div>
</section>

<!-- Closing -->
<section class="band dark closing">
  <div class="wrap" data-reveal>
    <h2>{s.cta.title[0]}<br />{s.cta.title[1]}</h2>
    <div class="cta-row">
      <span class="soon light">{s.hero.soon}</span>
      <a class="link light" href="#calc">{s.hero.try} ↑</a>
    </div>
    <p class="closing-note">{s.cta.privacy}</p>
  </div>
</section>

<script>
  import '../scripts/landing.js';
</script>
