---
// Shared frame for every page: dark navy, Space Grotesk and JetBrains Mono (IBM Plex Sans KR for Korean), a quiet
// header with the language switch, a footer, and the round back-to-top button.
import { t, type Lang, type Page, otherLang, href } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  page: Page;
}

const { lang, title, description, page } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(href(lang, page), Astro.site).toString();
const home = href(lang, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', page), Astro.site).toString()} />
    <link rel="alternate" hreflang="ko" href={new URL(href('ko', page), Astro.site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Laps" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Laps" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(`${base}/og.png`, Astro.site).toString()} />
    <meta name="theme-color" content="#070b14" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top" data-top>
      <div class="top-in">
        <a class="brand" href={home}>
          <img src={`${base}/icon.png`} alt="" width="32" height="32" />
          <span>Laps</span>
        </a>
        <nav>
          <a href={href(lang, 'support')} class:list={[{ on: page === 'support' }]}>{s.nav.support}</a>
          <a href={href(lang, 'privacy')} class:list={[{ on: page === 'privacy' }]}>{s.nav.privacy}</a>
          <a href={href(otherLang(lang), page)} hreflang={otherLang(lang)}>{s.nav.other}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bottom">
      <div class="bottom-in">
        <div class="links">
          <a href={`mailto:laps@wlswo.me`}>laps@wlswo.me</a>
          <a href={href(lang, 'support')}>{s.nav.support}</a>
          <a href={href(lang, 'privacy')}>{s.nav.privacy}</a>
        </div>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label={lang === 'ko' ? '맨 위로' : 'Back to top'}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" /></svg>
    </button>
    <script>
      // The header gets its hairline once the page has scrolled.
      const top = document.querySelector('[data-top]');
      // The round button bottom right shows once the page has scrolled a screen down, and goes back to the top.
      const toTop = document.querySelector('[data-to-top]');
      const onScroll = () => {
        top?.classList.toggle('scrolled', window.scrollY > 8);
        toTop?.classList.toggle('on', window.scrollY > window.innerHeight * 0.8);
      };
      toTop?.addEventListener('click', () => window.scrollTo({ top: 0 }));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #070b14;
    --text: #ffffff;
    --muted: rgba(255, 255, 255, .62);
    --line: rgba(255, 255, 255, .14);
    --nav: #f4d58d;
    --well: #e8ecf2;
    --deep: #0f172b;
    --orange: #f08a2b;
    --mono: 'JetBrains Mono', 'IBM Plex Sans KR', ui-monospace, monospace;
    --sans: 'Space Grotesk', 'IBM Plex Sans KR', system-ui, sans-serif;
    --ease: cubic-bezier(.2, .7, .2, 1);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
  html[lang='ko'] body { word-break: keep-all; }
  main { overflow-x: clip; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; }
  button { font: inherit; color: inherit; }
  ::selection { background: var(--orange); color: #fff; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .link { color: var(--nav); text-decoration: underline; text-decoration-color: rgba(244, 213, 141, .4); text-underline-offset: 4px; }

  .top { position: sticky; top: 0; z-index: 50; background: rgba(7, 11, 20, .78); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .top.scrolled { border-bottom-color: var(--line); }
  .top-in { max-width: 1180px; margin: 0 auto; padding: 20px 32px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; font: 700 20px var(--sans); }
  .brand img { width: 30px; height: 30px; border-radius: 8px; }
  .top nav { display: flex; gap: 40px; }
  .top nav a { font: 500 16px var(--sans); color: var(--nav); opacity: .9; transition: opacity .2s; }
  .top nav a:hover, .top nav a.on { opacity: 1; }
  .top nav a.on { text-decoration: underline; text-underline-offset: 6px; }

  .bottom { margin-top: 166px; border-top: 1px solid var(--line); }
  .bottom-in { max-width: 1180px; margin: 0 auto; padding: 30px 32px 50px; display: flex; gap: 28px; flex-wrap: wrap; font: 500 14px var(--sans); color: var(--muted); }
  .bottom .links { display: flex; gap: 28px; flex-wrap: wrap; }
  .bottom a:hover { color: var(--text); }

  .to-top {
    position: fixed; right: 24px; bottom: 24px; z-index: 60;
    width: 52px; height: 52px; border-radius: 50%; border: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--orange); color: #fff; cursor: pointer;
    box-shadow: 0 10px 26px rgba(240, 138, 43, .35);
    opacity: 0; transform: translateY(12px); pointer-events: none;
    transition: opacity .3s var(--ease), transform .3s var(--ease);
  }
  .to-top.on { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* Text pages: privacy, support. */
  .doc { max-width: 720px; margin: 64px auto 0; padding: 0 24px; }
  .doc .kicker { margin: 0; font: 600 14px var(--sans); color: var(--orange); }
  .doc h1 { font: 600 48px/1.15 var(--sans); margin: 6px 0 12px; letter-spacing: -1.2px; }
  .doc .updated { font: 500 14px var(--mono); color: var(--muted); margin: 0 0 28px; }
  .doc p { color: rgba(255, 255, 255, .82); }
  .doc p.lead { font-size: 20px; color: var(--text); }
  .doc h2 { font: 600 22px var(--sans); margin: 48px 0 14px; letter-spacing: -.3px; }
  .doc .box { padding: 6px 28px; border-radius: 24px; background: rgba(255, 255, 255, .05); border: 1px solid var(--line); }
  .doc dl { margin: 0; }
  .doc dt { font: 600 17px/1.45 var(--sans); padding: 18px 0 4px; }
  .doc dd { margin: 0; padding: 0 0 18px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .doc dd:last-of-type { border-bottom: 0; }
  .doc ul { color: rgba(255, 255, 255, .82); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
  @media (max-width: 640px) {
    body { font-size: 16px; }
    .wrap { padding: 0 16px; }
    .top-in { padding: 16px 18px; }
    .top nav { gap: 18px; }
    .top nav a { font-size: 14px; }
    .doc h1 { font-size: 36px; }
    .doc .box { padding: 4px 18px; }
  }
</style>
