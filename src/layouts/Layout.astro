---
// Shared frame for every page: the app's look (ink boxes, dithered shadows, Space Grotesk and JetBrains Mono,
// IBM Plex Sans KR for Korean), a header with the language switch and a footer.
import { t, type Lang, otherLang, href } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** The page's path without the language prefix: '', 'privacy', 'support'. */
  page: '' | 'privacy' | 'support';
}

const { lang, title, description, page } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(href(lang, page), Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', page), Astro.site).toString()} />
    <link rel="alternate" hreflang="ko" href={new URL(href('ko', page), Astro.site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/screens/${lang}/1.png`, Astro.site).toString()} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;600&family=JetBrains+Mono:wght@500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <a class="brand" href={href(lang, '')}>
        <img src={`${base}/icon.png`} alt="" width="36" height="36" />
        <span>Laps</span>
      </a>
      <nav>
        <a href={href(lang, 'support')} class:list={[{ on: page === 'support' }]}>{s.nav.support}</a>
        <a href={href(lang, 'privacy')} class:list={[{ on: page === 'privacy' }]}>{s.nav.privacy}</a>
        <a class="lang" href={href(otherLang(lang), page)} hreflang={otherLang(lang)}>{s.nav.other}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bottom">
      <div>
        <a href={`mailto:laps@wlswo.me`}>laps@wlswo.me</a>
        <a href={href(lang, 'support')}>{s.nav.support}</a>
        <a href={href(lang, 'privacy')}>{s.nav.privacy}</a>
      </div>
      <p>© 2026 JAEJIN BYUN</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1e293b;
    --deep: #0f172b;
    --paper: #f8fafc;
    --surface: #ffffff;
    --zebra: #f3f6fa;
    --hair: #e2e8f0;
    --muted: #64748b;
    --faint: #94a3b8;
    --accent: #f4b26b;
    --warn: #eb6834;
    --good: #1baf7a;
    --mono: 'JetBrains Mono', 'IBM Plex Sans KR', ui-monospace, monospace;
    --sans: 'Space Grotesk', 'IBM Plex Sans KR', system-ui, sans-serif;
    --dither: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'><rect x='0' y='0' width='1' height='1.4' fill='%230f172b'/><rect x='2' y='2' width='1' height='1.4' fill='%230f172b'/></svg>");
    --dither-light: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'><rect x='0' y='0' width='1' height='1.4' fill='%2394a3b8'/><rect x='2' y='2' width='1' height='1.4' fill='%2394a3b8'/></svg>");
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
  }
  main { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  a { color: var(--ink); }
  img { max-width: 100%; }

  /* An ink box with the app's dithered shadow. */
  .box { position: relative; background: var(--surface); border: 1.5px solid var(--ink); }
  .box::after {
    content: ''; position: absolute; left: 4px; top: 4px; right: -6px; bottom: -6px; z-index: -1;
    background-image: var(--dither); background-size: 4px 4px; opacity: .8;
  }
  .kicker { font: 700 13px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .link { font: 700 15px var(--mono); text-decoration: underline dotted; text-underline-offset: 5px; }

  .top {
    max-width: 1080px; margin: 0 auto; padding: 22px 20px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 22px var(--sans); }
  .brand img { border-radius: 9px; }
  .top nav { display: flex; gap: 22px; align-items: baseline; }
  .top nav a { font: 600 14px var(--mono); text-decoration: none; color: var(--muted); }
  .top nav a.on, .top nav a:hover { color: var(--ink); }
  .top nav a.lang { color: var(--ink); text-decoration: underline dotted; text-underline-offset: 5px; }

  .bottom {
    max-width: 1080px; margin: 96px auto 0; padding: 28px 20px 48px; border-top: 1.5px solid var(--ink);
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    font: 600 13px var(--mono); color: var(--muted);
  }
  .bottom div { display: flex; gap: 20px; flex-wrap: wrap; }
  .bottom a { color: var(--muted); text-decoration: none; }
  .bottom a:hover { color: var(--ink); }
  .bottom p { margin: 0; }

  /* Text pages: privacy, support. */
  .doc { max-width: 720px; margin: 40px auto 0; }
  .doc h1 { font: 700 40px/1.2 var(--sans); margin: 8px 0 6px; }
  .doc .updated { font: 600 13px var(--mono); color: var(--muted); margin: 0 0 28px; }
  .doc .box { padding: 6px 26px; }
  .doc h2 { font: 700 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 40px 0 12px; }
  .doc dl { margin: 0; }
  .doc dt { font: 600 17px/1.45 var(--sans); padding: 18px 0 4px; }
  .doc dd { margin: 0; padding: 0 0 18px; color: var(--ink); border-bottom: 1px solid var(--hair); }
  .doc dd:last-of-type { border-bottom: 0; }
  .doc p.lead { font-size: 19px; }

  @media (max-width: 640px) {
    body { font-size: 16px; }
    .top nav { gap: 14px; }
    .top nav a { font-size: 13px; }
    .doc h1 { font-size: 32px; }
    .doc .box { padding: 4px 18px; }
  }
</style>
