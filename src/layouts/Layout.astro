---
// Shared frame for every page: the app's look (ink boxes, dithered shadows, Space Grotesk and JetBrains Mono,
// IBM Plex Sans KR for Korean), a sticky header with the language switch, and a footer.
import { t, type Lang, type Page, otherLang, href } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  page: Page;
}

const { lang, title, description, page } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(href(lang, page), Astro.site).toString();
const home = href(lang, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', page), Astro.site).toString()} />
    <link rel="alternate" hreflang="ko" href={new URL(href('ko', page), Astro.site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/screens/${lang}/1.png`, Astro.site).toString()} />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top" data-top>
      <div class="top-in">
        <a class="brand" href={home}>
          <img src={`${base}/icon.png`} alt="" width="32" height="32" />
          <span>Laps</span>
        </a>
        <nav>
          <a class="wide" href={`${home}#calc`}>{s.nav.calc}</a>
          <a class="wide" href={`${home}#tour`}>{s.nav.tour}</a>
          <a href={`${home}#faq`}>{s.nav.faq}</a>
          <a href={href(lang, 'support')} class:list={[{ on: page === 'support' }]}>{s.nav.support}</a>
          <a class="lang" href={href(otherLang(lang), page)} hreflang={otherLang(lang)}>{s.nav.other}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bottom">
      <div class="bottom-in">
        <div class="links">
          <a href={`mailto:laps@wlswo.me`}>laps@wlswo.me</a>
          <a href={href(lang, 'support')}>{s.nav.support}</a>
          <a href={href(lang, 'privacy')}>{s.nav.privacy}</a>
        </div>
      </div>
    </footer>
    <button class="to-top" type="button" data-to-top aria-label={lang === 'ko' ? '맨 위로' : 'Back to top'}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" /></svg>
    </button>
    <script>
      // The header gets its hairline once the page has scrolled.
      const top = document.querySelector('[data-top]');
      // The round button bottom right shows once the page has scrolled a screen down, and goes back to the top.
      const toTop = document.querySelector('[data-to-top]');
      const onScroll = () => {
        top?.classList.toggle('scrolled', window.scrollY > 8);
        toTop?.classList.toggle('on', window.scrollY > window.innerHeight * 0.8);
      };
      toTop?.addEventListener('click', () => window.scrollTo({ top: 0 }));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1e293b;
    --deep: #0f172b;
    --paper: #f8fafc;
    --surface: #ffffff;
    --zebra: #f3f6fa;
    --hair: #e2e8f0;
    --muted: #64748b;
    --faint: #94a3b8;
    --accent: #f4b26b;
    --warn: #eb6834;
    --good: #1baf7a;
    --mono: 'JetBrains Mono', 'IBM Plex Sans KR', ui-monospace, monospace;
    --sans: 'Space Grotesk', 'IBM Plex Sans KR', system-ui, sans-serif;
    --ease: cubic-bezier(.2, .7, .2, 1);
    --dither: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'><rect x='0' y='0' width='1' height='1.4' fill='%230f172b'/><rect x='2' y='2' width='1' height='1.4' fill='%230f172b'/></svg>");
    --dither-white: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'><rect x='0' y='0' width='1' height='1.4' fill='white'/><rect x='2' y='2' width='1' height='1.4' fill='white'/></svg>");
    --dither-faint: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'><rect x='0' y='0' width='1' height='1.4' fill='%2394a3b8'/><rect x='2' y='2' width='1' height='1.4' fill='%2394a3b8'/></svg>");
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; scroll-padding-top: 72px; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  html[lang='ko'] body { word-break: keep-all; }
  main { overflow-x: clip; }
  a { color: var(--ink); }
  img { max-width: 100%; }
  button { font: inherit; color: inherit; }
  ::selection { background: var(--accent); color: var(--ink); }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  /* An ink box with the app's dithered shadow. The box keeps its own layers (fill over shadow), so the dots stay
     behind it even while it fades in. */
  .box { position: relative; isolation: isolate; border: 1.5px solid var(--ink); }
  .box::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--surface); pointer-events: none; }
  .box::after {
    content: ''; position: absolute; left: 4px; top: 4px; right: -6px; bottom: -6px; z-index: -2;
    background-image: var(--dither); background-size: 4px 4px; opacity: .8; pointer-events: none;
  }
  .kicker { font: 700 13px/1.3 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); white-space: pre; }
  .link { font: 700 15px var(--mono); text-decoration: underline dotted; text-underline-offset: 5px; }
  .num { font-variant-numeric: tabular-nums; }

  /* Scroll reveal: in once, no bounce. */
  [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  [data-reveal].in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    [data-reveal] { opacity: 1; transform: none; transition: none; }
    *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }

  .top { position: sticky; top: 0; z-index: 50; background: rgba(248, 250, 252, .82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color .3s; }
  .top.scrolled { border-bottom-color: var(--hair); }
  .top-in { max-width: 1120px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 21px var(--sans); }
  .brand img { border-radius: 8px; }
  .top nav { display: flex; gap: 24px; align-items: baseline; }
  .top nav a { font: 600 14px var(--mono); text-decoration: none; color: var(--muted); transition: color .2s; }
  .top nav a.on, .top nav a:hover { color: var(--ink); }
  .top nav a.lang { color: var(--ink); text-decoration: underline dotted; text-underline-offset: 5px; }

  .bottom { margin-top: 0; border-top: 1.5px solid var(--ink); }
  .bottom-in { max-width: 1120px; margin: 0 auto; padding: 28px 24px 48px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font: 600 13px var(--mono); color: var(--muted); }
  .bottom .links { display: flex; gap: 22px; flex-wrap: wrap; }
  .bottom a { color: var(--muted); text-decoration: none; }
  .bottom a:hover { color: var(--ink); }
  .bottom p { margin: 0; }

  .to-top {
    position: fixed; right: 24px; bottom: 24px; z-index: 60;
    width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid var(--ink);
    display: flex; align-items: center; justify-content: center;
    background: var(--accent); color: var(--ink); cursor: pointer;
    box-shadow: 3px 3px 0 var(--ink);
    opacity: 0; transform: translateY(12px); pointer-events: none;
    transition: opacity .3s var(--ease), transform .3s var(--ease);
  }
  .to-top.on { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  .to-top:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* Text pages: privacy, support. */
  .doc { max-width: 720px; margin: 56px auto 120px; padding: 0 24px; }
  .doc h1 { font: 700 44px/1.15 var(--sans); margin: 10px 0 8px; letter-spacing: -.5px; }
  .doc .updated { font: 600 13px var(--mono); color: var(--muted); margin: 0 0 28px; }
  .doc .box { padding: 6px 26px; }
  .doc h2 { font: 700 13px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 44px 0 14px; }
  .doc dl { margin: 0; }
  .doc dt { font: 600 17px/1.45 var(--sans); padding: 18px 0 4px; }
  .doc dd { margin: 0; padding: 0 0 18px; border-bottom: 1px solid var(--hair); }
  .doc dd:last-of-type { border-bottom: 0; }
  .doc p.lead { font-size: 19px; }

  @media (max-width: 760px) {
    body { font-size: 16px; }
    .top nav { gap: 14px; }
    .top nav a { font-size: 13px; }
    .top nav a.wide { display: none; }
    .doc h1 { font-size: 34px; }
    .doc .box { padding: 4px 18px; }
  }
</style>
